# Copy to .env for local use. In production, set these in Azure App Service
# configuration instead of a file.

# PostgreSQL connection. In production this must require TLS (sslmode=require).
DATABASE_URL=postgres://hv:hv@localhost:5432/healthville_dev

# Public address of the app, used in sign-in emails. No trailing slash.
APP_URL=http://localhost:3000

PORT=3000

# "production" turns on secure cookies and requires a real email setup.
NODE_ENV=development

# Email for sign-in links. Leave SMTP_HOST empty in development and the
# sign-in link is printed in the server log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Healthville <no-reply@example.org>"

# How long a sign-in link works, in minutes.
LOGIN_LINK_MINUTES=60
# How long someone stays signed in after their last visit, in days.
PARTICIPANT_SESSION_DAYS=30
STAFF_SESSION_HOURS=12
