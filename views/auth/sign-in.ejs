<%- include('../partials/head', { narrow: true }) %>
<div class="card">
  <h1>Sign in</h1>
  <p>Enter the email address you gave Healthville. We will email you a link to sign in. You do not need a password.</p>
  <% if (error) { %><div class="error-box" role="alert" id="email-error"><%= error %></div><% } %>
  <form method="post" action="/sign-in" novalidate>
    <div class="field">
      <label for="email">Email address</label>
      <input type="email" id="email" name="email" autocomplete="email" inputmode="email" value="<%= email %>" required <% if (error) { %>aria-describedby="email-error" aria-invalid="true"<% } %>>
    </div>
    <button type="submit" class="wide">Email me a sign-in link</button>
  </form>
</div>
<%- include('../partials/foot') %>
