<%- include('../partials/head', { narrow: true }) %>
<% var SP = content.spoons; %>
<p><a href="/tracker/spoons">Back to all days</a></p>
<h1>Submit your <%= SP.name %></h1>
<% if (!ready) { %>
  <div class="card">
    <h2>Nothing to submit yet</h2>
    <p>Open any day and cross off your spoons, then come back here.</p>
    <a class="button secondary" href="/tracker/spoons">Choose a day</a>
  </div>
<% } else { %>
  <div class="card">
    <h2>Your days</h2>
    <ul class="week-list">
    <% spDays.forEach(function (d, i) { var u = sp.days[i]; if (u === null) return; %>
      <li><span><%= time.formatDay(d) %></span><span><strong><%= u %> of <%= SP.perDay %></strong> used</span></li>
    <% }) %>
    </ul>
    <p>Days you did not open are fine. Once you submit, you cannot change this. Your facilitator will then be able to see it.</p>
    <form method="post" action="/tracker/spoons/submit">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="wide">Submit</button>
    </form>
  </div>
<% } %>
<%- include('../partials/foot') %>
