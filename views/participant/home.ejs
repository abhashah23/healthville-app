<%- include('../partials/head', { narrow: true }) %>
<% var firstName = user.name.split(' ')[0]; var pLabel = function (s) { return s === 'not_submitted' ? 'Closed' : statusLabels[s]; }; var SC = content.screening; %>
<h1>Hello, <%= firstName %></h1>

<% if (sc1.state === 'open' && sc1.status !== 'submitted') { %>
<section class="card" aria-labelledby="this-week">
  <h2 id="this-week"><%= content.tracker.name %></h2>
  <p>Before Session 1, start with the <%= SC.name %>: three short questions.</p>
  <p class="hint">Please fill it in before Session 1 starts: <%- include('../partials/deadline', { at: sc1.closes }) %>.</p>
  <a class="button wide" href="/tracker/screening/1"><%= sc1.status === 'in_progress' ? 'Continue' : 'Start' %></a>
</section>
<% } else if (current) { %>
<section class="card" aria-labelledby="this-week">
  <h2 id="this-week"><%= content.tracker.name %>, week <%= current.n %></h2>
  <% if (current.status === 'submitted') { %>
    <p>You have submitted this week. Thank you.</p>
    <% if (nextOpens) { %><p>Week <%= nextOpens.n %> opens on <%= time.formatDay(nextOpens.opens) %>.</p><% } %>
  <% } else { %>
    <% if (current.screening) { %>
      <p><%= SC.name %> (before Session <%= current.screening.s %>): <strong><%= current.screening.done ? 'done' : 'not done yet' %></strong></p>
    <% } %>
    <p><%= current.completed %> of 21 times filled in.</p>
    <svg class="progress" viewBox="0 0 21 1" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect width="21" height="1" class="progress-track"/><rect width="<%= current.completed %>" height="1" class="progress-fill"/></svg>
    <p class="hint">This week closes when your next session starts: <%- include('../partials/deadline', { at: current.closes }) %>.</p>
    <div class="actions">
      <a class="button wide" href="<%= continueUrl %>"><%= current.completed === 0 && !(current.screening && current.screening.started) ? 'Start this week' : 'Continue' %></a>
      <a class="button secondary wide" href="/tracker/week/<%= current.n %>">See the whole week</a>
    </div>
  <% } %>
</section>
<% } else if (nextOpens) { %>
<section class="card">
  <h2>Week <%= nextOpens.n %> opens on <%= time.formatDay(nextOpens.opens) %></h2>
  <p>You can start filling in your tracker from that day.</p>
</section>
<% } else { %>
<section class="card">
  <h2>All six weeks are finished</h2>
  <p>Your entries are below.</p>
</section>
<% } %>

<% [{ t: sp, name: content.spoons.name, url: '/tracker/spoons' }, { t: eb, name: content.energyBalance.name, url: '/tracker/energy' }].forEach(function (x, i) { if (x.t.state !== 'open') return; %>
<section class="card" aria-labelledby="practice-<%= i %>">
  <h2 id="practice-<%= i %>"><%= x.name %></h2>
  <% if (x.t.status === 'submitted') { %>
    <p>You have submitted it. Thank you.</p>
  <% } else { %>
    <p>Session 2 home practice. Fill in any days you like this week. <%= x.t.daysUsed ? x.t.daysUsed + ' day' + (x.t.daysUsed === 1 ? '' : 's') + ' filled in so far.' : '' %></p>
    <a class="button secondary wide" href="<%= x.url %>"><%= x.t.daysUsed ? 'Continue' : 'Start' %> the <%= x.name %></a>
  <% } %>
</section>
<% }) %>

<%- include('../partials/not-monitored') %>

<section class="card" aria-labelledby="my-trackers">
  <h2 id="my-trackers">My trackers</h2>
  <h3><%= content.tracker.name %></h3>
  <ul class="week-list">
    <li>
      <% if (sc1.state === 'upcoming') { %><span>Before Session 1: <%= SC.name %></span><% } else { %><a href="/tracker/screening/1">Before Session 1: <%= SC.name %></a><% } %>
      <span class="chip <%= sc1.status %>"><%= pLabel(sc1.status) %></span>
    </li>
    <% weeks.forEach(function (w) { %>
    <li>
      <% if (w.state === 'upcoming') { %>
        <span>Week <%= w.n %><%= w.n === SC.inWeek[6] ? ' (with ' + SC.name + ')' : '' %></span>
      <% } else { %>
        <a href="/tracker/week/<%= w.n %>">Week <%= w.n %><%= w.n === SC.inWeek[6] ? ' (with ' + SC.name + ')' : '' %></a>
      <% } %>
      <span class="chip <%= w.status %>"><%= pLabel(w.status) %></span>
    </li>
    <% }) %>
  </ul>
  <h3>Session 2 home practice</h3>
  <ul class="week-list">
    <% [{ t: sp, name: content.spoons.name, url: '/tracker/spoons' }, { t: eb, name: content.energyBalance.name, url: '/tracker/energy' }].forEach(function (x) { %>
    <li>
      <% if (x.t.state === 'upcoming') { %><span><%= x.name %></span><% } else { %><a href="<%= x.url %>"><%= x.name %></a><% } %>
      <span class="chip <%= x.t.status %>"><%= pLabel(x.t.status) %></span>
    </li>
    <% }) %>
  </ul>
</section>

<% if (chart) { %>
<section class="card" aria-labelledby="my-chart">
  <h2 id="my-chart">My scores over the weeks</h2>
  <p class="hint">Averages from the weeks you submitted.</p>
  <%- chart %>
  <%- include('../partials/averages-table', { rows: averages }) %>
</section>
<% } %>
<%- include('../partials/foot', { scripts: ['/js/localtime.js'] }) %>
