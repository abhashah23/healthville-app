<%- include('../partials/head', { narrow: true }) %>
<% var SP = content.spoons; var n = 0; for (var k = 0; k < SP.perDay; k++) if (crossed & (1 << k)) n++; %>
<p><a href="/tracker">Back to my tracker</a></p>
<h1><%= SP.heading %></h1>
<p class="hint"><%= time.formatDay(date) %></p>
<form class="card" method="post" action="/tracker/spoons" data-spoon-form data-date="<%= date.toISODate() %>" data-dates="<%= allowedDates.join(',') %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="date" value="<%= date.toISODate() %>">
  <p><%= SP.instruction %></p>
  <div class="spoon-buttons">
    <% for (var i = 0; i < SP.perDay; i++) { var off = Boolean(crossed & (1 << i)); %>
    <button type="submit" name="spoon" value="<%= i %>" class="spoon-btn" aria-pressed="<%= off %>" aria-label="Spoon <%= i + 1 %>">
      <svg class="spoon <%= off ? 'used' : '' %>" viewBox="0 0 24 48" aria-hidden="true" focusable="false">
        <ellipse cx="12" cy="11" rx="8" ry="10"/>
        <path d="M10 20 Q9 34 9.5 44 Q12 47 14.5 44 Q15 34 14 20 Z"/>
        <line x1="3" y1="45" x2="21" y2="3" class="cross"/>
      </svg>
    </button>
    <% } %>
  </div>
  <p class="spoons-text" role="status" aria-live="polite" data-spoon-text><%= n %> crossed off, <%= SP.perDay - n %> left.</p>
</form>
<%- include('../partials/foot', { scripts: ['/js/spoons.js'] }) %>
