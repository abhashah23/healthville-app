<%- include('../partials/head', { narrow: true }) %>
<% var SP = content.spoons; var submitted = sp.sheet && sp.sheet.submitted_at; %>
<p><a href="/tracker">Back to my tracker</a></p>
<h1><%= SP.name %></h1>
<p class="hint"><%= SP.heading %>, from the My Spoons handout. Session 2 home practice.</p>
<% if (submitted) { %>
  <p><span class="chip submitted">Submitted</span> on <%= time.formatTimestamp(sp.sheet.submitted_at) %>. It cannot be changed now.</p>
<% } else if (spEditable) { %>
  <p>You start each day with <%= SP.perDay %> spoons. <%= SP.instruction %> Fill in any days you like this week.</p>
  <p class="hint">This closes <%- include('../partials/deadline', { at: spCloses }) %>. Your facilitator sees it once you submit, or once it closes.</p>
<% } else { %>
  <p><span class="chip not_submitted">Closed</span> This closed before it was submitted. You can still see what you entered.</p>
<% } %>

<section class="card" aria-labelledby="sp-days">
  <h2 id="sp-days"><%= spEditable ? 'Choose a day' : 'Your days' %></h2>
  <ul class="eb-day-list">
  <% spDays.forEach(function (d, i) { var u = sp.days[i]; var label = u === null ? 'Nothing yet' : u + ' of ' + SP.perDay + ' spoons used, ' + (SP.perDay - u) + ' left'; %>
    <li>
      <% if (spEditable) { %>
        <a class="eb-day <%= u !== null ? 'used' : '' %>" href="/tracker/spoons/day/<%= i + 1 %>"><span class="eb-day-name"><%= time.formatDay(d) %></span><span class="hint"><%= label %></span></a>
      <% } else { %>
        <div class="eb-day <%= u !== null ? 'used' : '' %>"><span class="eb-day-name"><%= time.formatDay(d) %></span><span class="hint"><%= label %></span></div>
      <% } %>
    </li>
  <% }) %>
  </ul>
</section>
<% if (spEditable) { %><div class="actions"><a class="button wide" href="/tracker/spoons/review">Review and submit</a></div><% } %>
<%- include('../partials/foot', { scripts: ['/js/localtime.js'] }) %>
