<%- include('../partials/head', { narrow: true }) %>
<% var EB = content.energyBalance; var submitted = eb.sheet && eb.sheet.submitted_at; %>
<p><a href="/tracker">Back to my tracker</a></p>
<h1><%= EB.name %></h1>
<p class="hint"><%= EB.fullName %>. Session 2 home practice.</p>
<% if (submitted) { %>
  <p><span class="chip submitted">Submitted</span> on <%= time.formatTimestamp(eb.sheet.submitted_at) %>. It cannot be changed now.</p>
<% } else if (ebEditable) { %>
  <p>Fill in any days you like this week. For each day, add the activities that used energy and the ones that gave energy back, with points from 1 to 4.</p>
  <p class="hint">This closes <%- include('../partials/deadline', { at: ebCloses }) %>. Your facilitator sees it once you submit, or once it closes.</p>
<% } else { %>
  <p><span class="chip not_submitted">Closed</span> This closed before it was submitted. You can still see what you entered.</p>
<% } %>

<% if (ebEditable) { %>
<section class="card" aria-labelledby="eb-days">
  <h2 id="eb-days">Choose a day</h2>
  <ul class="eb-day-list">
  <% ebDays.forEach(function (d, i) { var dd = eb.days[i]; %>
    <li><a class="eb-day <%= dd.count ? 'used' : '' %>" href="/tracker/energy/day/<%= i + 1 %>">
      <span class="eb-day-name"><%= time.formatDay(d) %></span>
      <span class="hint"><% if (dd.count) { %><%= dd.activity.length %> activit<%= dd.activity.length === 1 ? 'y' : 'ies' %>, <%= dd.replenish.length %> replenishing. <%= Math.max(0, dd.spoonsLeft) %> of <%= EB.dailySpoons %> spoons left.<% } else { %>Nothing yet<% } %></span>
    </a></li>
  <% }) %>
  </ul>
</section>
<div class="actions"><a class="button wide" href="/tracker/energy/review">Review and submit</a></div>
<% } else { %>
  <% var any = false; ebDays.forEach(function (d, i) { var dd = eb.days[i]; if (!dd.count) return; any = true; %>
  <section class="card">
    <h2><%= time.formatDay(d) %></h2>
    <%- include('../partials/energy-day-table', { dayData: dd }) %>
  </section>
  <% }); if (!any) { %><div class="card"><p>Nothing was entered.</p></div><% } %>
<% } %>
<%- include('../partials/foot', { scripts: ['/js/localtime.js'] }) %>
