<%- include('../partials/head', { narrow: true }) %>
<% var SP = content.spoons; var used = sp.days[day] || 0; %>
<p><a href="/tracker/spoons">Back to all days</a></p>
<h1><%= time.formatDay(spDays[day]) %></h1>
<p class="hint"><%= SP.name %></p>

<section class="card" aria-labelledby="today-title">
  <h2 id="today-title"><%= SP.heading %></h2>
  <p><%= SP.instruction %></p>
  <%- include('../partials/spoon-row', { used: used }) %>
  <p class="spoons-text" role="status" aria-live="polite" data-spoon-text data-total="<%= SP.perDay %>"><strong><%= used %> of <%= SP.perDay %> spoons used.</strong> <%= SP.perDay - used %> left.</p>
  <form method="post" action="/tracker/spoons/day/<%= day + 1 %>" class="actions" data-spoon-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="wide" name="change" value="add"><%= SP.crossOff %></button>
    <button type="submit" class="secondary wide" name="change" value="remove"><%= SP.putBack %></button>
  </form>
  <p class="save-status" data-save-status></p>
</section>
<div class="actions"><a class="button secondary wide" href="/tracker/spoons">Done with this day</a></div>
<%- include('../partials/foot', { scripts: ['/js/spoons.js'] }) %>
