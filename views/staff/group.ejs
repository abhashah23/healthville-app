<%- include('../partials/head') %>
<p><a href="/staff">All groups</a></p>
<h1><%= group.name %></h1>
<p>Starts <%= time.formatDay(time.sessionDay(group.session1_date, 1)) %>.</p>

<section class="card" aria-labelledby="grid-title">
  <h2 id="grid-title">Trackers by participant</h2>
  <% if (!grid.length) { %><p>No participants in this group yet.</p><% } else { %>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Status table, scrolls sideways on small screens">
  <table class="grid">
    <caption class="visually-hidden">Weekly tracker status for each participant, weeks 1 to 6</caption>
    <thead><tr><th scope="col">Participant</th><% weekNumbers.forEach(function (n) { %><th scope="col">Week <%= n %></th><% }) %><th scope="col"><%= content.spoons.name %></th><th scope="col"><%= content.energyBalance.name %></th></tr></thead>
    <tbody>
    <% grid.forEach(function (p) { %>
      <tr>
        <th scope="row"><a href="/staff/participants/<%= p.id %>"><%= p.name %></a><br><span class="hint"><%= p.participant_code %></span></th>
        <% p.weeks.forEach(function (s) { %><td><%- include('../partials/status', { status: s }) %></td><% }) %>
        <td><%= p.spDays === null ? 'Not open yet' : p.spDays ? p.spDays + ' day' + (p.spDays === 1 ? '' : 's') : 'Nothing yet' %></td>
        <td><%- include('../partials/status', { status: p.eb }) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>
</section>

<section class="card" aria-labelledby="summary-title">
  <h2 id="summary-title">Group summary</h2>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Summary table, scrolls sideways on small screens">
  <table>
    <caption class="visually-hidden">Submissions and average score by week</caption>
    <thead><tr><th scope="col">Week</th><th scope="col">Submitted</th><th scope="col">Group average score</th></tr></thead>
    <tbody>
    <% summary.forEach(function (s) { %>
      <tr>
        <th scope="row">Week <%= s.week %></th>
        <td><%= s.submitted %> of <%= s.total %></td>
        <td><%= s.average === null ? 'No submitted weeks' : s.average.toFixed(1) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <p class="hint">Averages use submitted weeks only, across all days and times of day.</p>
  <p><strong><%= content.spoons.name %>:</strong> <%= spUsers %> of <%= grid.length %> have crossed off spoons.</p>
  <p><strong><%= content.energyBalance.name %>:</strong> <%= ebSubmitted %> of <%= grid.length %> submitted.</p>
  <% if (chart) { %><%- chart %><% } %>
</section>
<%- include('../partials/foot') %>
