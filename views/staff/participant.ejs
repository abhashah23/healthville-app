<%- include('../partials/head') %>
<p><a href="/staff/groups/<%= group.id %>">Back to <%= group.name %></a></p>
<h1><%= participant.name %></h1>
<p>Participant code <strong><%= participant.participant_code %></strong>. <%= group.name %>.<% if (!participant.active) { %> <span class="chip not_started">Account turned off</span><% } %></p>

<section class="card" aria-labelledby="sc-title">
  <h2 id="sc-title"><%= content.screening.name %></h2>
  <div class="sc-compare">
  <% screenings.forEach(function (sc) { var r = sc.row; var show = r && (sc.status === 'submitted' || sc.status === 'not_submitted'); %>
    <div class="sc-col">
      <h3>Before Session <%= sc.s %> <%- include('../partials/status', { status: sc.status }) %></h3>
      <% if (!show) { %>
        <p class="empty"><%= sc.status === 'in_progress' ? 'Appears once submitted, or once Session ' + sc.s + ' starts.' : 'Nothing yet.' %></p>
      <% } else { %>
        <% if (sc.status === 'not_submitted') { %><p class="hint">Not submitted. This is what was entered.</p><% } %>
        <p><strong><%= content.screening.tiredQuestion %></strong><br><%= r.tired_score !== null ? r.tired_score + ' out of 10' : 'Not answered' %></p>
        <p><strong><%= content.screening.severityQuestion %></strong><br><%= r.severity ? content.screening.severityOptions.filter(function (o) { return o.key === r.severity; })[0].label : 'Not answered' %></p>
        <p><strong><%= content.screening.patternQuestion %></strong></p>
        <p class="pre"><%= r.pattern || 'Not answered' %></p>
      <% } %>
    </div>
  <% }) %>
  </div>
</section>

<section class="card" aria-labelledby="weeks-title">
  <h2 id="weeks-title">Weeks at a glance</h2>
  <ul class="week-list">
  <% weeks.forEach(function (w) { %>
    <li><span><% if (w.hasData && w.status !== 'in_progress') { %><a href="#week-<%= w.n %>">Week <%= w.n %></a><% } else { %>Week <%= w.n %><% } %></span><%- include('../partials/status', { status: w.status }) %></li>
  <% }) %>
  </ul>
  <p class="hint">Entries for the current week appear once it is submitted, or once it closes at the start of the next session.</p>
</section>

<% if (chart) { %>
<section class="card" aria-labelledby="chart-title">
  <h2 id="chart-title">Fatigue across the six weeks</h2>
  <%- chart %>
  <%- include('../partials/averages-table', { rows: averages }) %>
</section>
<% } %>

<details class="card week" id="energy">
  <summary><%= content.energyBalance.name %>&nbsp;<%- include('../partials/status', { status: eb.status }) %></summary>
  <% if (eb.status === 'submitted' || eb.status === 'not_submitted') { %>
    <% if (eb.status === 'submitted') { %><p class="hint">Submitted <%= time.formatTimestamp(eb.sheet.submitted_at) %>.</p><% } else { %><p class="hint">Not submitted. This is what was entered before it closed.</p><% } %>
    <% var anyDay = false; eb.dates.forEach(function (d, i) { var dd = eb.days[i]; if (!dd.count) return; anyDay = true; %>
      <div class="entry-day">
        <h3><%= time.formatDay(d) %></h3>
        <%- include('../partials/energy-day-table', { dayData: dd }) %>
      </div>
    <% }); if (!anyDay) { %><p class="empty">Nothing entered.</p><% } %>
  <% } else if (eb.status === 'in_progress') { %>
    <p class="hint">Entries appear once it is submitted, or once it closes at the start of Session <%= content.energyBalance.week + 1 %>.</p>
  <% } else { %>
    <p class="empty">Nothing yet.</p>
  <% } %>
</details>

<% var shown = weeks.filter(function (w) { return w.hasData && w.status !== 'in_progress'; }); %>
<% if (shown.length) { %><h2>Weekly entries</h2><% } %>
<% shown.forEach(function (w, idx) { %>
<details class="card week" id="week-<%= w.n %>" <%= idx === shown.length - 1 ? 'open' : '' %>>
  <summary>Week <%= w.n %>&nbsp;<%- include('../partials/status', { status: w.status }) %></summary>
  <% if (w.status === 'submitted') { %><p class="hint">Submitted <%= time.formatTimestamp(w.week.row.submitted_at) %>.</p><% } else { %><p class="hint">Not submitted. This is what was entered before the week closed.</p><% } %>
  <% w.days.forEach(function (d, i) { %>
    <div class="entry-day">
      <h3><%= time.formatDay(d) %></h3>
      <% content.tracker.timesOfDay.forEach(function (t) { var e = w.week.entries[i + '-' + t.key]; %>
        <div class="entry-row">
          <div><strong><%= t.label %></strong></div>
          <div>
            <% if (!e || (e.score === null && !e.activity && !e.notes)) { %><span class="empty">Nothing entered</span><% } else { %>
              <% if (e.score !== null) { %><strong><%= e.score %></strong> <%- include('../partials/band', { score: e.score }) %><% } else { %><span class="empty">No score</span><% } %>
              <div class="what"><%= e.activity || '' %></div>
              <% if (e.notes) { %><div class="notes">Notes: <%= e.notes %></div><% } %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% }) %>
  <h3>Weekly reflection</h3>
  <% content.tracker.reflections.forEach(function (r) { var v = w.week.row ? w.week.row[r.key] : ''; %>
    <p><strong><%= r.label %></strong><br><% if (v) { %><%= v %><% } else { %><span class="empty">Not answered</span><% } %></p>
  <% }) %>
</details>
<% }) %>
<%- include('../partials/foot') %>
