<% var total = content.spoons.perDay; var crossed = used || 0; %>
<div class="spoons" aria-hidden="true" data-spoons>
  <% for (var i = 0; i < total; i++) { var off = i >= total - crossed; %>
  <svg class="spoon <%= off ? 'used' : '' %>" viewBox="0 0 24 48" focusable="false">
    <ellipse cx="12" cy="11" rx="8" ry="10"/>
    <path d="M10 20 Q9 34 9.5 44 Q12 47 14.5 44 Q15 34 14 20 Z"/>
    <line x1="3" y1="45" x2="21" y2="3" class="cross"/>
  </svg>
  <% } %>
</div>
