<%- include('../partials/head', { narrow: true }) %>
<p><a href="/admin">Admin</a></p>
<h1>Groups</h1>
<% groups.forEach(function (g) { %>
  <div class="card">
    <h2><a href="/admin/groups/<%= g.id %>"><%= g.name %></a></h2>
    <p>Session 1: <%= time.formatDay(time.sessionDay(g.session1_date, 1)) %></p>
  </div>
<% }) %>
<form class="card" method="post" action="/admin/groups">
  <h2>Add a group</h2>
  <% if (error) { %><div class="error-box" role="alert"><%= error %></div><% } %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label for="name">Group name</label>
    <input type="text" id="name" name="name" value="<%= form.name || '' %>" maxlength="100">
  </div>
  <div class="field">
    <label for="session1_date">Date of Session 1</label>
    <p class="hint">Must be a Thursday. Week 1 opens that day.</p>
    <input type="date" id="session1_date" name="session1_date" value="<%= form.session1_date || '' %>">
  </div>
  <button type="submit">Add group</button>
</form>
<%- include('../partials/foot') %>
